# Elements API
ELEMENTS_API_URL=https://api.elements.charter.com
ELEMENTS_API_USER=your_username
ELEMENTS_API_PASS=your_password

# Output DB — Latency Management TimescaleDB (where poller writes lm_ tables)
DB_HOST=<output_db_host>
DB_PORT=5432
DB_USER=<output_db_user>
DB_PASS=<output_db_pass>
DB_NAME=<output_db_name>

# Source DB — ipdr_data_for_histograms (MACs pulled from ds_histograms_enabled_modems)
DB_HOST_MANAGED=<source_db_host>
DB_PORT_MANAGED=5432
DB_NAME_MANAGED=<source_db_name>
DB_USER_MANAGED=<source_db_user>
DB_PASS_MANAGED=<source_db_pass>
# NOTE: source and output DB may be on the same host

# Polling
POLL_INTERVAL=300
API_TIMEOUT=25
CONCURRENCY=10
