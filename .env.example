# Elements API
ELEMENTS_API_URL=https://api.elements.charter.com
ELEMENTS_API_USER=<your_username>
ELEMENTS_API_PASS=<your_password>

# PostgreSQL / TimescaleDB (production)
DB_HOST=<db_host>
DB_PORT=5433
DB_NAME=<db_name>
DB_USER=<db_user>
DB_PASS=<db_password>

# PostgreSQL / TimescaleDB (dev)
DB_HOST_DEV=<dev_db_host>
DB_PORT_DEV=5433
DB_NAME_DEV=<dev_db_name>
DB_USER_DEV=<dev_db_user>
DB_PASS_DEV=<dev_db_password>

# Source DB — managed modem list (Latency Management poller only)
DB_HOST_MANAGED=<source_db_host>
DB_PORT_MANAGED=5432
DB_NAME_MANAGED=<source_db_name>
DB_USER_MANAGED=<source_db_user>
DB_PASS_MANAGED=<source_db_password>

# Polling
POLL_INTERVAL=60
API_TIMEOUT=25
CONCURRENCY=10
MODEM_LIST_FILE=modem_list.txt

# SNMP Poller (cmts_snmp_poller.py)
# Add targets directly in the TARGETS list in the script
SNMP_PORT=161
SNMP_TIMEOUT=5
SNMP_RETRIES=2
